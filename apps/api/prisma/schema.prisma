generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  TENANT_ADMIN
  OPERATOR
}

enum DeviceStatus {
  PENDING_ENROLLMENT // ⏳ Creado en el panel, esperando que el celular instale la app / mande IMEI
  ACTIVE             // 🟢 Vinculado y al día
  LOCKED             // 🔒 Bloqueado por falta de pago o robo
  DISABLED           // ⚪ Dado de baja
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  devices Device[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(OPERATOR)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Device {
  id                 String       @id @default(uuid())
  imei               String?      @unique // Opcional: Se auto-completa cuando el teléfono se conecta
  model              String
  status             DeviceStatus @default(PENDING_ENROLLMENT)
  enrollmentCode     String?      @unique // Código/QR para vincular el celular automáticamente

  // 👤 Datos del Comprador (Opcionales)
  buyerName          String?
  buyerDni           String?
  buyerPhone         String?

  // 💵 Plan de Cuotas y Vencimientos (Opcionales)
  price              Float?       // Precio total de la venta
  downPayment        Float?       // Entrega inicial
  installmentAmount  Float?       // Valor de cada cuota
  totalInstallments  Int?         // Cantidad de cuotas
  paidInstallments   Int?         @default(0) // Cuotas pagadas
  paymentFrequency   String?      // 'SEMANAL', 'QUINCENAL', 'MENSUAL'
  dueDate            DateTime?    // Fecha próximo vencimiento
  gracePeriodDays    Int?         @default(3) // Días de tolerancia antes de bloquear
  autoLockEnabled    Boolean      @default(true) // Si bloquea solo al vencer

  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  lastSeenAt         DateTime?

  @@map("devices")
}